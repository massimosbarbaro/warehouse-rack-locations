Private Sub ScLiberi()
Dim sqlc As String, rsT As Recordset, sT As String, sT1 As String, sT2 As String
Dim fP As Boolean, i As Integer, fP1 As Boolean, fP2 As Boolean, sT3 As String
Dim fP3 As Boolean, sT4 As String, fP4 As Boolean, sT5 As String
sT = ""
fP = False
fP1 = False
fP2 = False
fP3 = False
fP4 = False



sT = "Where not (Ids="
sqlc = "Select IdS " & _
        "From Legami " & _
        "Where Stato='E'"
        
Set rsT = db.OpenRecordset(sqlc, dbOpenSnapshot)
    If Not rsT.EOF Then
        i = 0
        Do While Not rsT.EOF
                
                Select Case i
                Case Is < 70
                        If Not fP Then
                            sT1 = sT1 & rsT(0)
                            fP = True
                        Else
                            sT1 = sT1 & " or IdS=" & rsT(0)
                        End If
                Case Is < 140
                        If Not fP1 Then
                            sT2 = sT2 & rsT(0)
                            fP1 = True
                        Else
                            sT2 = sT2 & " or IdS=" & rsT(0)
                        End If
                Case Is < 210
                        If Not fP2 Then
                            sT3 = sT3 & rsT(0)
                            fP2 = True
                        Else
                            sT3 = sT3 & " or IdS=" & rsT(0)
                        End If
                
                Case Is > 211
                        If Not fP3 Then
                            sT4 = sT4 & rsT(0)
                            fP3 = True
                        Else
                            sT4 = sT4 & " or IdS=" & rsT(0)
                        End If
'Da attivare in caso di altro scaffale
'                Case Is > 281
'                        If Not fP4 Then
'                            sT5 = sT5 & rsT(0)
'                            fP4 = True
'                        Else
'                            sT5 = sT5 & " or IdS=" & rsT(0)
'                        End If
                
                
                End Select
            
        rsT.MoveNext
        i = i + 1
        Loop

    End If


Select Case i

Case Is < 70
    sT = sT & sT1 & ") "
Case Is < 140
    sT = sT & sT1 & ") and not (Ids=" & sT2 & ")"
Case Is < 210
    sT = sT & sT1 & ") and not (Ids=" & sT2 & ")and not (Ids=" & sT3 & ")"
Case Is < 280
    sT = sT & sT1 & ") and not (Ids=" & sT2 & ")and not (Ids=" & sT3 & ")and not (Ids=" & sT4 & ")"


End Select


sSc = sT

rsT.Close
Set rsT = Nothing
    

End Sub
Private Sub SalvaQta()
Dim sqlc As String, rsQ As Recordset, sQ As String
Dim sId As String, rsNum As Recordset, sNum As String

ControlloQta

sQ = txtQta.Text
sId = txtId.Text

sqlc = "Select max(IdP) " & _
        "From Pallette"
    
    Set rsNum = db.OpenRecordset(sqlc, dbOpenSnapshot)
    If Not IsNull(rsNum(0)) Then
        sNum = rsNum(0) + 1
    Else
        sNum = 1
    End If

rsNum.Close
Set rsNum = Nothing


sqlc = "Select IdP, Id, Qta " & _
        "From Pallette "
Set rsQ = db.OpenRecordset(sqlc, dbOpenDynaset)

rsQ.AddNew
    rsQ("IdP") = sNum
    rsQ("Id") = sId
    rsQ("Qta") = sQ
rsQ.Update


rsQ.Close
Set rsQ = Nothing

End Sub
Private Sub SalvaSc()
Dim sqlc As String, rsR As Recordset, sR As String
Dim sSc As String, sC As String, rsL As Recordset, sIdS As String
Dim rsT As Recordset, sIdP As String
'ControlloSc 'Controllo di aver selzionato uno scaffale

'Estraggo l 'id dello scaffale preciso
sSc = cmbScaffale.Text
sR = cmbRiga.Text
sC = cmbColonna.Text

sqlc = "Select IdS, Scaffale, Riga, Colonna " & _
        "From Scaffali " & _
        "where Scaffale=" & sSc & " AND Riga='" & sR & _
        "' AND Colonna=" & sC
        
    
    Set rsR = db.OpenRecordset(sqlc, dbOpenSnapshot)
    If Not rsR.EOF Then
        sIdS = rsR("IdS")
    End If
    
    
rsR.Close
Set rsR = Nothing

'Trovo l'idp che mi serve

sqlc = "Select max(IdP) " & _
        "From Pallette"
Set rsT = db.OpenRecordset(sqlc, dbOpenSnapshot)

    sIdP = rsT(0)
    
rsT.Close
Set rsT = Nothing
'Carico i dati nella tabella legame

sqlc = "SELECT IdP, IdS, Stato, DataE, DataU " & _
        "FROM Legami "

