Private Sub CercaIdC()
Dim sqlc As String, rsT As Recordset, iRes As Integer

Dim i As Integer, nFields As Integer

i = 0
sqlc = "SELECT ID, ODL, DataApertura, CodiceArticolo, Articolo, Cliente, " & _
            "CodCliente, UM, QtaOrdinata, QtaKg, Tipo, Subbio, BobineKg, " & _
            "Diametro, LunghezzaBobine, Spessore, Altezza, Lunghezza, " & _
            "Finitura, Rete, CNV, CodiceArticoloCliente, CapitolatoCliente, " & _
            "CapitolatoArticolo " & _
        "From ODL " & _
        "WHERE ID=" & txtId.Text
        
        
Set rsT = db.OpenRecordset(sqlc, dbOpenSnapshot)
If Not rsT.EOF Then
   nFields = rsT.Fields.Count
    
      For i = 0 To nFields - 1
         Select Case rsT.Fields(i).Type
            
            Case dbText '
                If Not IsNull(rsT(i)) Then
                    txtCal(i) = rsT(i)
                    txtCal(i).Visible = True
                    txtCal(i).Locked = True
         
                 Else
                     txtCal(i) = ""
                 End If
            Case dbDate
                If Not IsNull(rsT(i)) Then
                    txtCal(i) = rsT(i)
                    txtCal(i).Visible = True
                    txtCal(i).Locked = True
                 
                 Else
                     txtCal(i) = ""
                 End If
            Case Else
                If Not IsNull(rsT(i)) Then
                    txtCal(i) = rsT(i)
                    txtCal(i).Visible = True
                    txtCal(i).Locked = True
                 
                 Else
                     txtCal(i) = 0
                 End If
         End Select
        
      Next i
Me.Status = cNotExists
Else
            iRes = MsgBox("Non si sono individuati ID. Aggiorniamo gli archivi?", _
            vbYesNo + vbDefaultButton2 + vbQuestion)
            If iRes = vbYes Then
                Load frmExportMFG
                frmExportMFG.Key = "Aggiorna"
                frmExportMFG.Show
            Else
                txtId.Enabled = True

            End If
End If

 
        
End Sub
